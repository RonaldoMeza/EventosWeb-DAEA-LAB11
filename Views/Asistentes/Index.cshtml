@model IEnumerable<Asistente>
@{ ViewData["Title"] = "Asistentes"; }
<div class="d-flex justify-content-between align-items-center"><h1>Asistentes</h1><a asp-action="Create" class="btn btn-primary">Nuevo asistente</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
<table class="table table-striped"><thead><tr><th>Nombres</th><th>DNI</th><th>Correo</th><th>Teléfono</th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Nombres</td><td>@item.Dni</td><td>@item.Correo</td><td>@(item.Telefono ?? "—")</td></tr> }</tbody></table>
