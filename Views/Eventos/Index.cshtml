@model IEnumerable<Evento>
@{ ViewData["Title"] = "Eventos"; }
<h1>Eventos</h1>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
<div class="d-flex justify-content-between mb-3"><form method="get" class="d-flex gap-2"><select name="categoriaId" asp-items="ViewBag.Categorias" class="form-select"><option value="">Todas las categorías</option></select><button class="btn btn-outline-primary">Filtrar</button></form><a asp-action="Create" class="btn btn-primary">Nuevo evento</a></div>
<table class="table table-striped"><thead><tr><th>Título</th><th>Fecha</th><th>Lugar</th><th>Modalidad</th><th>Categoría</th><th>Aforo</th><th>Confirmados</th><th>Cupos</th><th>Precio</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { var confirmados = item.Inscripciones.Count(i => i.Estado == "Confirmada"); <tr><td>@item.Titulo</td><td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td><td>@item.Lugar</td><td>@item.Modalidad</td><td>@item.Categoria.Nombre</td><td>@item.Aforo</td><td>@confirmados</td><td>@Math.Max(0, item.Aforo-confirmados)</td><td>S/ @item.Precio.ToString("N2")</td><td class="text-nowrap"><a asp-action="Details" asp-route-id="@item.Id">Detalle</a> | <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> | <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a></td></tr> }
</tbody></table>
