@model IEnumerable<Inscripcion>
@{ ViewData["Title"] = "Inscripciones"; }
<div class="d-flex justify-content-between align-items-center"><h1>Inscripciones</h1><a asp-action="Create" class="btn btn-primary">Nueva inscripción</a></div>
@if (TempData["Mensaje"] is string mensaje) { <div class="alert alert-success">@mensaje</div> }
<table class="table table-striped"><thead><tr><th>Evento</th><th>Asistente</th><th>Fecha de inscripción</th><th>Estado</th><th></th></tr></thead><tbody>@foreach (var item in Model) { <tr><td>@item.Evento.Titulo</td><td>@item.Asistente.Nombres</td><td>@item.FechaInscripcion.ToString("dd/MM/yyyy HH:mm")</td><td>@item.Estado</td><td>@if (item.Estado == "Confirmada") { <form asp-action="Cancelar" asp-route-id="@item.Id" method="post" onsubmit="return confirm('¿Cancelar esta inscripción?');"><button class="btn btn-sm btn-outline-danger">Cancelar</button></form> }</td></tr> }</tbody></table>
